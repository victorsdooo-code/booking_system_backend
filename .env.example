# Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/qingyiu_clinic?retryWrites=true&w=majority

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS (optional - comma separated origins)
# CORS_ORIGINS=https://your-frontend.com,https://another-frontend.com
